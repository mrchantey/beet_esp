# Wi-Fi credentials and device address for the firmware + `beet` CLI.
# Copy to .env and fill in. Loaded at build time via env! (see WifiPlugin) and at
# runtime by the `beet` CLI (dotenv).
#
WIFI_SSID=your-network-name
WIFI_PASSWORD=your-password
# Static IPv4 the firmware binds (WifiPlugin::with_env_static_ip). Omit for DHCP.
# A /24 with the gateway at .1 is assumed.
WIFI_STATIC_IP=192.168.0.50
# Where the `beet` CLI sends scene commands (load/clear/dump/run/reset). Point it
# at the device's address + the firmware's port (8337, `DEFAULT_SERVER_PORT`), so
# `beet load scenes/roomba.bsx` targets the device.
BEET_REMOTE_URL=http://192.168.0.50:8337
