# Wi-Fi credentials and device address for the firmware + `beet` CLI.
# Copy to .env and fill in. Loaded at build time via env! (see WifiPlugin,
# build.rs `load_dotenv`) and at runtime by the `beet` CLI (dotenv).
#
# The firmware reads these at compile time, so the names must match the `env!`
# keys in src/net/mod.rs exactly. BEET_WIFI_SSID and BEET_WIFI_PASSWORD are
# required (env!) — the build fails without them.
BEET_WIFI_SSID=your-network-name
BEET_WIFI_PASSWORD=your-password
# Static IPv4 the firmware binds (WifiPlugin::with_env_static_ip, option_env!).
# Omit for DHCP. A /24 with the gateway at .1 is assumed.
BEET_WIFI_STATIC_IP=192.168.0.50
# Optional socket server the perceive-act loop dials (option_env!,
# src/net/socket_client.rs). A bare host:port is prefixed as ws://; a wss://
# url needs the `secure` feature. Omit to disable.
# BEET_SOCKET_SERVER=wss://192.168.0.10:8338
# Where the `secure` feature reads beet's dev certificate to pin at build time
# (a dir containing cert.pem). Defaults to the sibling beet workspace's
# target/tls; run any beet server with `secure` once to generate it.
# BEET_TLS_DIR=/path/to/beet/target/tls
# Where the `beet` CLI sends scene commands (load/clear/dump/run/reset). Point it
# at the device's address + the firmware's port (8337, `DEFAULT_SERVER_PORT`), so
# `beet load scenes/roomba.bsx` targets the device.
BEET_REMOTE_URL=http://192.168.0.50:8337
