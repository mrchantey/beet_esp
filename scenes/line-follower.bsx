<!-- Alvik line follower: a bang-bang follow step every 50ms.
     Push with `beet load scenes/line-follower.bsx`, run with `beet run line-follower`. -->
<RouteAction path="line-follower">
	<Repeat><Sequence>
		<LineFollowStep/>
		<EndInDuration duration="50ms"/>
	</Sequence></Repeat>
</RouteAction>
