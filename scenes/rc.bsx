<!-- Alvik remote control: two direct route handlers under one router. Drive the
     robot with `beet run drive/forward` (forward/back/left/right/stop) and toggle
     a UI LED with `beet run led/left/on`. Push with `beet load scenes/rc.bsx`. -->
<Router>
	<DriveRoute {At{path:"drive/:dir"}}/>
	<LedRoute {At{path:"led/:side/:state"}}/>
</Router>
