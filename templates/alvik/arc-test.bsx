<!-- Arc test: linear=60 mm/s + angular=90 deg/s for 5s, then stop. Adding linear
     velocity to the same turn rate as spin-test widens the spin into a smooth arc
     (a curved path, not a spin in place) — the carrier interpolates linear+angular
     into the wheels. Push with `beet load templates/alvik/arc-test.bsx`, run with
     `beet run arc-test`. -->
<RouteAction path="arc-test">
	<Sequence>
		<SetDrive linear={60.0} angular={90.0}/>
		<EndInDuration duration="5s"/>
		<SetDrive linear={0.0} angular={0.0}/>
	</Sequence>
</RouteAction>
