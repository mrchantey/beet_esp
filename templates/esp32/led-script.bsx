<!-- Bare-ESP32 demo: the on-board WS2812 driven by a script program, cycling
     red/green/blue from the elapsed time and counting ticks in `state`. Repeats
     every 100ms. Push with `beet load scenes/led-script.bsx`, run with
     `beet run led-script`. -->
<RouteAction path="led-script">
	<Repeat><Sequence>
		<LedScript script='{
			const count = "count" in input.state ? input.state.count : 0;
			const phase = Math.floor(input.elapsed_ms / 500) % 3;
			const led = phase == 0 ? 0xff0000 : phase == 1 ? 0x00ff00 : 0x0000ff;
			return { led, state: { count: count + 1 } };
		}'/>
		<EndInDuration duration="100ms"/>
	</Sequence></Repeat>
</RouteAction>
